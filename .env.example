TANK_SERVER_HOST=0.0.0.0
TANK_SERVER_PORT=5000
TANK_CAMERA_INDEX=0
TANK_CAMERA_WIDTH=1280
TANK_CAMERA_HEIGHT=720
TANK_CAMERA_SENSOR_WIDTH=4608
TANK_CAMERA_SENSOR_HEIGHT=2592
TANK_CAMERA_STREAM_PORT=8081
TANK_SECONDARY_CAMERA_STREAM_PORT=8082
TANK_VISION_ENABLED=false
TANK_VISION_SOURCE_URL=http://127.0.0.1:8081/stream.mjpg
TANK_VISION_MODEL_PATH=models/yolo-nano.onnx
# One of: disabled | opencv_onnx | fake
# - disabled    : no detection runs (safe default).
# - opencv_onnx : real YOLO ONNX backend (requires opencv-python-headless).
# - fake        : synthetic detections for manual UI verification only.
#                 Clearly labelled FAKE/TEST in /api/vision/status. Never
#                 sends drive commands. No model file required.
TANK_VISION_MODEL_BACKEND=disabled
TANK_VISION_SAMPLE_FPS=2
TANK_VISION_CONFIDENCE=0.45
TANK_VISION_FRAME_WIDTH=640
# Optional: source aspect ratio (width/height) for the overlay helper.
# Defaults to 16/9 when unset.
TANK_VISION_SOURCE_ASPECT=1.7777777778
# Monitor-only safety: defaults intentionally exclude person/dog so the
# cockpit never marks them as targetable in this phase.
TANK_VISION_TARGET_LABELS=tennis ball,traffic cone,marker
TANK_VISION_HAZARD_LABELS=chair,backpack,suitcase,bottle,box,cup,sports ball,potted plant,traffic cone,unknown obstacle
TANK_SERIAL_PORT=/dev/ttyACM0
TANK_SERIAL_BAUD=115200
TANK_SERIAL_WRITE_TIMEOUT=1.0
TANK_SERIAL_READY_DELAY=2.0
TANK_DEFAULT_DRIVE_SPEED=50
TANK_DEFAULT_DRIVE_DURATION_MS=400