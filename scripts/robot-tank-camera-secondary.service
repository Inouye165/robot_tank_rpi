[Unit]
Description=Robot Tank Secondary Camera Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ron
WorkingDirectory=/home/ron/repos/robot_tank_rpi
Environment=TANK_CAMERA_INDEX=0
Environment=TANK_CAMERA_WIDTH=640
Environment=TANK_CAMERA_HEIGHT=480
Environment=TANK_CAMERA_SENSOR_WIDTH=3280
Environment=TANK_CAMERA_SENSOR_HEIGHT=2464
Environment=TANK_CAMERA_STREAM_PORT=8082
ExecStart=/home/ron/repos/robot_tank_rpi/scripts/start_camera_stream.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target