[Unit]
Description=Robot Tank Camera Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ron
WorkingDirectory=/home/ron/repos/robot_tank_rpi
Environment=TANK_CAMERA_STREAM_PORT=8081
ExecStart=/home/ron/repos/robot_tank_rpi/scripts/start_camera_stream.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target